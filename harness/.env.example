# Copy to .env and fill in. .env is gitignored; never commit a real key.
# Pipeline model (reading client sources): replay (default, recorded outputs, no network) or openai
HARNESS_MODEL=replay
OPENAI_API_KEY=
# With a key set, 'Ask about this role' and study-answer feedback use OpenAI even when HARNESS_MODEL=replay.
# Set HARNESS_ASSIST=replay to keep them offline too.
HARNESS_ASSIST=
# Model id for the live run (any chat model that supports JSON output)
OPENAI_MODEL=gpt-4o-mini
PORT=3000
