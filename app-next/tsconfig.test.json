{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noEmit": true,
    "incremental": false
  },
  "include": [
    "lib/**/*.ts",
    "test/**/*.ts",
    "cli/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}