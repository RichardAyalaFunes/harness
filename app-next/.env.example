# Copy to .env (gitignored). Never commit a key.
# The pipeline model: replay (offline, recorded outputs) or openai
HARNESS_MODEL=replay
# Set to replay to keep "Ask about this role" and study feedback offline even when a key exists
# HARNESS_ASSIST=replay
OPENAI_API_KEY=
# gpt-4o-mini was too unreliable for the extraction contract in the live baseline; use gpt-4o or newer.
OPENAI_MODEL=gpt-4o
# Logs: debug | info | warn | error | silent
LOG_LEVEL=info
# Trace payloads: full (redacted inputs and outputs) | meta (sizes and hashes only) | off
TRACE_PAYLOADS=full
TRACE_RETENTION_DAYS=7
# Only behind a proxy that terminates TLS: comma-separated full origins allowed to call the API, for example https://app.example.org
# TRUSTED_ORIGINS=
