{
  "name": "radhires-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RadHires: one Next.js service (UI + API + AI harness). Spike stage P1.",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/unit/*.test.ts\"",
    "test:integration": "next build && node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/integration/*.test.ts\"",
    "test:e2e": "next build && playwright test",
    "test:all": "pnpm typecheck && pnpm test && pnpm test:integration && playwright test",
    "harness": "node --disable-warning=ExperimentalWarning cli/harness.ts",
    "rebuild": "node --disable-warning=ExperimentalWarning cli/harness.ts rebuild"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~5.9.3"
  }
}